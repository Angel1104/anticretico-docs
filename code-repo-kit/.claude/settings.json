{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git push origin epic/:*)",
      "Bash(git push origin task/:*)",
      "Bash(git push origin fix/:*)",
      "Bash(git push origin bug/:*)",
      "Bash(git push origin hotfix/:*)",
      "Bash(git push origin spike/:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr comment:*)",
      "Bash({{install}}:*)",
      "Bash({{test}}:*)",
      "Bash({{lint}}:*)",
      "Bash({{e2e}}:*)",
      "Bash(git worktree list:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(gh workflow:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin v:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git tag:*)",
      "Bash(terraform apply:*)",
      "Bash(git worktree remove:*)",
      "Bash(git worktree prune:*)",
      "Bash(git branch -D:*)",
      "Bash(git reset --hard:*)"
    ]
  }
}
