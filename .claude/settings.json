{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin epic/:*)",
      "Bash(git push origin fix/:*)",
      "Bash(git push origin bug/:*)",
      "Bash(git push origin hotfix/:*)",
      "Bash(git push origin spike/:*)",
      "Bash(git tag:*)",
      "Bash(git push origin v:*)",
      "Bash(gh issue:*)",
      "Bash(gh project:*)",
      "Bash(gh label:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh run:*)",
      "Bash(claude -p:*)",
      "Bash(git -C:*)",
      "Bash(cd:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(gh release:*)",
      "Bash(terraform apply:*)"
    ]
  }
}
